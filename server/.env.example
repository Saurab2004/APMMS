# Copy this file to ".env" and change the values.
# NEVER commit your real .env file.

NODE_ENV=development
PORT=5000

# Default local MongoDB Community Server
MONGO_URI=mongodb://127.0.0.1:27017/apmms

# Use a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# The exact address of the React app (used for CORS and cookies)
CLIENT_ORIGIN=http://localhost:5173

# Uploaded files are stored here (relative to the server folder)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Set to 1 only when running behind a reverse proxy (nginx, etc.)
TRUST_PROXY=0

# First-time platform setup: the very first coordinator (who becomes the "platform owner" and approves every later
# institution) registers on the Register page with this secret code. Not needed on a brand-new LOCAL database in
# development, but REQUIRED in production. Change it to your own secret.
COORDINATOR_SETUP_CODE=

# ---- Email (verification emails) ----
# The public address people open in the browser. Verification links in emails start with this.
APP_URL=http://localhost:5173
# Who the email appears to come from
EMAIL_FROM="APMMS <no-reply@yourdomain.com>"
# SMTP settings from your email provider (Gmail App Password, Brevo, Mailgun, SendGrid SMTP...).
# Leave SMTP_HOST empty in development: the verification link is then printed in the server window instead.
SMTP_HOST=
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# How long a verification link stays valid (hours)
EMAIL_VERIFY_HOURS=24

# ---- Institutions ----
# When a coordinator deletes their institution, everything is blocked at once and erased for good after this many days
# (the platform owner can restore it before then). 0 = erase immediately.
INSTITUTION_PURGE_DAYS=14
